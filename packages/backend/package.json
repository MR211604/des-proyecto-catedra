{
  "name": "@des-proyecto/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit --pretty false",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@clerk/express": "^2.1.61",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "prisma": "^7.9.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
